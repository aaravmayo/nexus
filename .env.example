# Server environment
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# Supabase (Auth, Postgres, Vector, Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# NVIDIA NIM Configuration
NIM_API_KEY=nvapi-your-key-here
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_CHAT_MODEL=meta/llama-3.1-8b-instruct
NIM_EMBED_MODEL=baai/bge-m3
NIM_EMBED_DIMENSION=1024
NIM_TIMEOUT_MS=30000

# Security Secrets
RATE_LIMIT_SALT=replace-with-random-secret-for-ip-hashing
CLEANUP_SECRET=replace-with-secret-for-internal-cleanup-cron

# Optional Demo
DEMO_ASSISTANT_PUBLIC_ID=
